# ===== 后端服务环境变量 =====

# HMAC签名密钥（请改为随机字符串，至少32位）
QR_SECRET=change-this-to-a-random-secret-key-1234567890

# 企业微信群机器人Webhook地址
WEWORK_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key

# 服务端口（Render会自动分配PORT）
PORT=10000

# 单笔金额上限
MAX_AMOUNT=1000000

# 有效期天数
EXPIRE_DAYS=3

# 数据库类型（sqlite 或 supabase）
DB_TYPE=sqlite
